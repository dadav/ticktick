# TickTick Configuration

# Database path (default: ./data/ticktick.db)
TICKTICK_DB_PATH=./data/ticktick.db

# Weekly work hours requirement (default: 41)
TICKTICK_WEEKLY_HOURS=41

# Maximum daily work hours (default: 10)
TICKTICK_MAX_DAILY_HOURS=10

# Hours before lunch break is deducted (default: 6)
TICKTICK_LUNCH_THRESHOLD=6

# Lunch break duration in minutes (default: 30)
TICKTICK_LUNCH_DURATION=30

# Server host (default: 0.0.0.0)
TICKTICK_HOST=0.0.0.0

# Server port (default: 8000)
TICKTICK_PORT=8000

# Gotify start reminder (disabled unless URL and token are set)
TICKTICK_GOTIFY_URL=
TICKTICK_GOTIFY_TOKEN=
TICKTICK_GOTIFY_PRIORITY=5

# Remind between these local times if no work was recorded today (HH:MM)
TICKTICK_REMINDER_TIME=09:00
TICKTICK_REMINDER_CUTOFF=12:00

# Workdays: weekdays minus public holidays (country/subdivision codes, e.g. DE / BY)
TICKTICK_REMINDER_WEEKDAYS=mon,tue,wed,thu,fri
TICKTICK_HOLIDAY_COUNTRY=DE
TICKTICK_HOLIDAY_SUBDIV=
